{
  "bin": {
    "sentinel": "bin/sentinel.js",
    "sentinel-mcp": "mcp/sentinel-mcp.js"
  },
  "description": "Read-only PR review CLI with pinned HEAD and deterministic exit codes.",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "apps/",
    "bench/cases/",
    "bench/report.js",
    "bench/runner.js",
    "bin/",
    "console/",
    "docs/",
    "lib/",
    "mcp/",
    "policies/",
    "scripts/",
    "README.md"
  ],
  "license": "MIT",
  "name": "@aftergraph/sentinel",
  "scripts": {
    "serve": "node bin/sentinel.js serve",
    "smoke:console": "bash scripts/console-smoke.sh",
    "test": "node --test test/*.test.mjs",
    "verify:model-evidence": "node scripts/verify-model-evidence.mjs",
    "verify:labs-preflight": "node scripts/verify-labs-preflight.mjs"
  },
  "type": "module",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftergraph/sentinel.git"
  },
  "homepage": "https://aftergraph.org/sentinel",
  "bugs": {
    "url": "https://github.com/Aftergraph/sentinel/issues"
  },
  "keywords": [
    "code-review",
    "verification",
    "github-app",
    "ai-agents",
    "mcp",
    "sarif"
  ]
}
