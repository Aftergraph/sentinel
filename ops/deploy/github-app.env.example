# Sentinel GitHub App — host environment.
# Install to /etc/sentinel/github-app.env, owner root:sentinel, mode 0640.
# Never commit a filled copy of this file.

# --- required ---------------------------------------------------------------
# Same value as the webhook secret on the GitHub App registration.
# Leave empty only for poll-only mode (SENTINEL_GITHUB_POLL=1 + App credentials);
# webhooks are then refused with 503.
GITHUB_WEBHOOK_SECRET=

# --- GitHub auth: App credentials win over a plain token -------------------
# App mode (preferred): the numeric App ID and the PEM downloaded once at
# registration. GITHUB_INSTALLATION_ID is optional; the app resolves the sole
# installation when it is absent.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/etc/sentinel/github-app.pem
GITHUB_INSTALLATION_ID=

# Token mode (fallback, e.g. first smoke test): a PAT with repo read plus
# pull-request write. Leave empty when App mode is configured.
GITHUB_TOKEN=

# --- listener ---------------------------------------------------------------
# Cloudflare Tunnel forwards to this port on 127.0.0.1; no public port opens.
PORT=8787

# --- state (optional; defaults live under the process working directory) ----
SENTINEL_LEDGER=/var/lib/sentinel/ledger.jsonl
SENTINEL_MEMORY=/var/lib/sentinel/memory.json
SENTINEL_GITHUB_STORE=/var/lib/sentinel/installations.json
SENTINEL_CONFIG=/etc/sentinel/sentinel.config.json

# --- optional behaviour -----------------------------------------------------
# GitHub App credential mode always publishes Sentinel check runs using the
# installation token (requires Checks: read/write and Actions: read).
# This switch only enables checks for token-mode compatibility deployments.
SENTINEL_GITHUB_CHECKS=1
# Compatibility fallback only for non-App/gh transport.
SENTINEL_GH_TOKEN=

# Outbound-only fallback/primary mode. Uses the GitHub App installation token
# to discover repositories and open PRs; no public webhook ingress is required.
# Start with an explicit allowlist, then widen deliberately.
SENTINEL_GITHUB_POLL=0
SENTINEL_GITHUB_POLL_INTERVAL_MS=30000
SENTINEL_GITHUB_POLL_REPOS=Aftergraph/sentinel
SENTINEL_GITHUB_POLL_STATE=/var/lib/sentinel/github-poll-state.json
