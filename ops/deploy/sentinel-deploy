#!/usr/bin/env bash
# Root-owned deploy entrypoint for the Sentinel GitHub App on the VDS.
# Installed to /usr/local/sbin/sentinel-deploy by ops/deploy/install-deploy-sudo.sh.
# The CI runner user gets sudo for THIS path only: no wildcards, no shell-quoted
# argument matching, which is what made the hand-written sudoers invalid.
#
# Trust note: `install` runs ops/deploy/install.sh from the runner's checkout,
# exactly as the workflow did before. The wrapper narrows sudo to fixed verbs and
# checks the checkout is at the requested commit; it does not make the runner
# checkout more trustworthy than the CI that produced it.
set -euo pipefail

UNIT=sentinel-github-app.service
REVISION_FILE=/opt/sentinel/.source-revision
ENV_FILE=/etc/sentinel/github-app.env

die() { echo "sentinel-deploy: $*" >&2; exit 2; }

[[ "${EUID}" -eq 0 ]] || die "must run as root (via sudo -n)"

verb="${1:-}"; shift || true
case "${verb}" in
  preflight)
    [[ $# -eq 0 ]] || die "preflight takes no arguments"
    echo ok
    ;;
  env-preflight)
    [[ $# -eq 0 ]] || die "env-preflight takes no arguments"
    # Fail closed before install/restart. Prints only port and auth kind, never values.
    [[ -r "${ENV_FILE}" ]] || die "${ENV_FILE} missing"
    envget() { awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "${ENV_FILE}" | tr -d '[:space:]'; }
    port="$(envget PORT)"
    [[ "${port}" =~ ^[0-9]+$ ]] || die "PORT is not set in ${ENV_FILE}"
    app_id="$(envget GITHUB_APP_ID)"; key_file="$(envget GITHUB_APP_KEY_FILE)"
    if [[ -n "${app_id}" && -n "${key_file}" ]]; then
      [[ -s "${key_file}" ]] || die "GITHUB_APP_KEY_FILE is missing or empty"
      auth=app
    elif [[ -n "$(envget GITHUB_TOKEN)" ]]; then
      auth=token
    else
      die "no GitHub auth configured in ${ENV_FILE}"
    fi
    echo "port=${port} auth=${auth}"
    ;;
  install)
    [[ $# -eq 2 ]] || die "usage: install <checkout-dir> <40-hex-sha>"
    src="$(realpath -e -- "$1")"; sha="$2"
    [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die "sha must be 40 lowercase hex"
    [[ -f "${src}/ops/deploy/install.sh" ]] || die "no ops/deploy/install.sh under ${src}"
    head="$(git -c safe.directory="${src}" -C "${src}" rev-parse HEAD)"
    [[ "${head}" == "${sha}" ]] || die "checkout HEAD ${head} != requested ${sha}"
    dirty="$(git -c safe.directory="${src}" -C "${src}" status --porcelain --untracked-files=no)"
    [[ -z "${dirty}" ]] || die "checkout has modified tracked files"
    # Install from a root-owned copy of exactly that commit, never from the
    # runner-writable checkout itself (install.sh refuses non-root sources).
    stage="$(mktemp -d /root/sentinel-src.XXXXXX)"
    trap 'rm -rf -- "${stage}"' EXIT
    chmod 0700 "${stage}"
    git -c safe.directory="${src}" -C "${src}" archive --format=tar "${sha}" \
      | tar -x --no-same-owner --no-same-permissions -C "${stage}"
    chown -R root:root "${stage}"
    [[ -f "${stage}/ops/deploy/install.sh" ]] || die "archive of ${sha} has no ops/deploy/install.sh"
    bash "${stage}/ops/deploy/install.sh"
    rm -rf -- "${stage}"; trap - EXIT
    tmp="$(mktemp)"; printf '%s\n' "${sha}" > "${tmp}"
    install -o root -g root -m 0444 "${tmp}" "${REVISION_FILE}"; rm -f "${tmp}"
    ;;
  restart)
    [[ $# -eq 0 ]] || die "restart takes no arguments"
    systemctl restart "${UNIT}"
    systemctl is-active --quiet "${UNIT}"
    ;;
  revision)
    [[ $# -eq 0 ]] || die "revision takes no arguments"
    cat "${REVISION_FILE}"
    ;;
  port)
    [[ $# -eq 0 ]] || die "port takes no arguments"
    awk -F= '$1=="PORT" {print $2}' "${ENV_FILE}" | tail -n 1 | tr -d '[:space:]'
    ;;
  hashes)
    [[ $# -eq 0 ]] || die "hashes takes no arguments"
    # /opt/sentinel is 0750 sentinel:sentinel, so the runner cannot read it directly.
    sha256sum /opt/sentinel/lib/rulepack.js /opt/sentinel/lib/fihim-operator-deployment-verifier.mjs
    ;;
  webhook-check)
    [[ $# -eq 0 ]] || die "webhook-check takes no arguments"
    node /opt/sentinel/bin/sentinel-github-webhook-secret.mjs check "${ENV_FILE}"
    ;;
  webhook-rotate)
    # Optional URL moves the App webhook in the same PATCH as the new secret.
    [[ $# -le 1 ]] || die "usage: webhook-rotate [https://<name>.aftergraph.org/webhooks/github]"
    if [[ $# -eq 1 ]]; then
      [[ "$1" =~ ^https://[a-z0-9-]+\.aftergraph\.org/webhooks/github$ ]] || die "url must be https://<name>.aftergraph.org/webhooks/github"
    fi
    # Secret is generated, stored and registered on this host; never printed.
    node /opt/sentinel/bin/sentinel-github-webhook-secret.mjs rotate "${ENV_FILE}" "$@"
    ;;
  ingress-enable)
    [[ $# -eq 1 ]] || die "usage: ingress-enable <name>.aftergraph.org"
    host="$1"
    [[ "${host}" =~ ^[a-z0-9-]+\.aftergraph\.org$ ]] || die "host must be <name>.aftergraph.org"
    # Same as certbot below: ingress-enable owns its own dependency, so a fresh
    # VDS does not fail the deploy with "nginx is not installed".
    if ! command -v nginx >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null || die "apt-get update failed while installing nginx"
      DEBIAN_FRONTEND=noninteractive apt-get install -y -q nginx >/dev/null || die "nginx is missing and could not be installed"
      command -v nginx >/dev/null 2>&1 || die "nginx is not installed"
      systemctl enable --now nginx >/dev/null 2>&1 || die "nginx was installed but could not be started"
    fi
    port="$(awk -F= '$1=="PORT" {print $2}' "${ENV_FILE}" | tail -n 1 | tr -d '[:space:]')"; port="${port:-8787}"
    [[ "${port}" =~ ^[0-9]+$ ]] || die "PORT in ${ENV_FILE} is not numeric"
    # DNS must already point here, or Let's Encrypt cannot validate.
    want="$(getent ahostsv4 "${host}" | awk '{print $1}' | sort -u)"
    [[ -n "${want}" ]] || die "${host} does not resolve yet (add an A record, DNS only)"
    here=false
    for ip in ${want}; do
      if ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1 | grep -qx "${ip}"; then here=true; fi
      if [[ "$(curl -4 -s --max-time 5 https://api.ipify.org || true)" == "${ip}" ]]; then here=true; fi
    done
    [[ "${here}" == true ]] || die "${host} resolves, but not to this machine"
    if [[ -d /etc/nginx/sites-enabled ]] && grep -Eq 'include[[:space:]]+/etc/nginx/sites-enabled' /etc/nginx/nginx.conf; then
      site=/etc/nginx/sites-available/sentinel-webhook.conf; link=/etc/nginx/sites-enabled/sentinel-webhook.conf
    else
      site=/etc/nginx/conf.d/sentinel-webhook.conf; link=""
    fi
    acme=/var/www/sentinel-acme; live="/etc/letsencrypt/live/${host}"
    install -d -m 0755 "${acme}"
    backup=""; if [[ -e "${site}" ]]; then backup="$(mktemp)"; cp -a "${site}" "${backup}"; fi
    restore() {
      if [[ -n "${backup}" ]]; then cp -a "${backup}" "${site}"; else rm -f "${site}"; [[ -n "${link}" ]] && rm -f "${link}"; fi
      nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
    }
    apply_site() {
      [[ -n "${link}" ]] && ln -sfn "${site}" "${link}"
      if ! nginx -t >/dev/null 2>&1; then nginx -t || true; restore; die "nginx -t failed; previous config restored"; fi
      systemctl reload nginx
    }
    http_block() {
      cat <<'NGX' | sed -e "s|__HOST__|${host}|g" -e "s|__ACME__|${acme}|g"
# Managed by sentinel-deploy ingress-enable. Only /webhooks/github is proxied.
server {
    listen 80;
    server_name __HOST__;
    location ^~ /.well-known/acme-challenge/ { root __ACME__; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}
NGX
    }
    tls_block() {
      cat <<'NGX' | sed -e "s|__HOST__|${host}|g" -e "s|__LIVE__|${live}|g" -e "s|__PORT__|${port}|g"
server {
    listen 443 ssl;
    server_name __HOST__;
    ssl_certificate __LIVE__/fullchain.pem;
    ssl_certificate_key __LIVE__/privkey.pem;
    client_max_body_size 25m;
    location = /webhooks/github {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:__PORT__/webhooks/github;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
    location / { return 404; }
}
NGX
    }
    cert=present
    if [[ ! -s "${live}/fullchain.pem" ]]; then
      http_block > "${site}"; apply_site
      if ! command -v certbot >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive apt-get install -y -q certbot >/dev/null || die "certbot is missing and could not be installed"
      fi
      certbot certonly --webroot -w "${acme}" -d "${host}" --non-interactive --agree-tos \
        --register-unsafely-without-email --keep-until-expiring \
        --deploy-hook "systemctl reload nginx" >/dev/null 2>&1 || { certbot certonly --webroot -w "${acme}" -d "${host}" --non-interactive --agree-tos --register-unsafely-without-email --keep-until-expiring 2>&1 | tail -n 5 >&2 || true; die "certificate for ${host} could not be issued"; }
      cert=issued
    fi
    { http_block; echo; tls_block; } > "${site}"; apply_site
    [[ -n "${backup}" ]] && rm -f "${backup}"
    printf '{"ingress_host":"%s","dns_points_here":true,"cert":"%s","nginx":"reloaded"}\n' "${host}" "${cert}"
    ;;
  host-facts)
    [[ $# -eq 0 ]] || die "host-facts takes no arguments"
    # Booleans only: Actions logs on this public repo must not carry IPs or names.
    has() { command -v "$1" >/dev/null 2>&1 && echo true || echo false; }
    ts_running=false; ts_funnel=false
    if command -v tailscale >/dev/null 2>&1; then
      tsj="$(tailscale status --json 2>/dev/null || true)"
      grep -q '"BackendState": *"Running"' <<<"${tsj}" && ts_running=true
      grep -q 'https://tailscale.com/cap/funnel' <<<"${tsj}" && ts_funnel=true
    fi
    l80=false; l443=false
    ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)80$' && l80=true
    ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)443$' && l443=true
    cf_cfg=false; [[ -e /etc/cloudflared/config.yml || -e /root/.cloudflared/cert.pem ]] && cf_cfg=true
    printf '{"tailscale":%s,"tailscale_running":%s,"tailscale_funnel_cap":%s,"cloudflared":%s,"cloudflared_configured":%s,"caddy":%s,"nginx":%s,"listen_80":%s,"listen_443":%s}\n' \
      "$(has tailscale)" "${ts_running}" "${ts_funnel}" "$(has cloudflared)" "${cf_cfg}" "$(has caddy)" "$(has nginx)" "${l80}" "${l443}"
    ;;
  diagnose)
    [[ $# -eq 0 ]] || die "diagnose takes no arguments"
    systemctl status "${UNIT}" --no-pager -n 0 || true
    # Only boot/fail-closed lines: poll summaries may name private repos.
    journalctl -u "${UNIT}" -n 200 --no-pager -o cat \
      | grep -E 'fail closed|listening on|Error|EADDRINUSE|EACCES|ENOENT|requires' \
      | grep -v 'sentinel github poll ' | tail -n 20 || true
    ;;
  *)
    die "unknown verb '${verb}' (preflight|env-preflight|install|restart|revision|port|hashes|webhook-check|webhook-rotate|ingress-enable|host-facts|diagnose)"
    ;;
esac
