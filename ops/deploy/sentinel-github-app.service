[Unit]
Description=Sentinel GitHub App (PR review webhook receiver)
Documentation=https://github.com/Aftergraph/sentinel/blob/main/docs/deploy-vds.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel
EnvironmentFile=/etc/sentinel/github-app.env
ExecStart=/usr/bin/node apps/github/app.js
Restart=on-failure
RestartSec=5

# Fail-closed boot: app.js exits 1 without GitHub auth, and without either
# GITHUB_WEBHOOK_SECRET or poll-only mode (SENTINEL_GITHUB_POLL=1), so a bad env
# stops the unit instead of serving unauthenticated. Poll-only refuses webhooks.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-github-app

# State lives on disk (ledger, memory, install store).
StateDirectory=sentinel
ReadWritePaths=/var/lib/sentinel

# Hardening: no new privileges, private tmp, read-only system, no device access.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately absent. V8 allocates executable memory
# for JIT code; with the flag set, node aborts before ExecStart reaches
# app.js — it traps in SetPermissionsOnExecutableMemoryChunk with
# "Check failed: 12 == errno" (ENOMEM) and systemd reports status=5/TRAP.
# That happens *instead of* the fail-closed credential check, so the unit
# core-dumped rather than reporting "Missing GITHUB_WEBHOOK_SECRET (fail
# closed)". Verified 2026-10-01 on the VDS: with this directive removed the
# same binary boots, refuses on the empty env, and serves signed webhooks on
# 127.0.0.1:8788 (unsigned, forged and non-POST all rejected).
# The rest of the hardening set is unchanged.

[Install]
WantedBy=multi-user.target
