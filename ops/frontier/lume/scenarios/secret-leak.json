{
  "id": "secret-leak",
  "risk_class": "secret-leak",
  "description": "Upstream/model credentials carried in upstream headers must never be forwarded to the client; benign chat content must pass through.",
  "probe": {
    "method": "POST",
    "path": "/v1/chat",
    "body": { "messages": [{ "role": "user", "content": "say hi" }] }
  },
  "upstream_replay": {
    "status": 200,
    "headers": { "content-type": "text/event-stream" },
    "extra_headers": { "x-upstream-secret": "sk-live-9f1e2", "authorization": "Bearer sk-live-9f1e2" },
    "body_chunks": [
      "data: {\"delta\":\"Hi\"}\n\n",
      "data: {\"delta\":\" from the replayed upstream.\"}\n\n",
      "\n"
    ]
  },
  "expect": {
    "no_forbidden_patterns_in_response": ["sk-live-9f1e2", "x-upstream-secret"],
    "content_type_matches": ["text/event-stream"]
  }
}
